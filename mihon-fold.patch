index 0000000..7e94ea1
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/ui/reader/viewer/webgpu/FoldSpread.kt
@@ -0,0 +1,14 @@
+package eu.kanade.tachiyomi.ui.reader.viewer.webgpu
+
+/** Width / height from which "When wide or unfolded" pairs pages. */
+private const val DUAL_PAGE_MIN_ASPECT_RATIO = 0.8f
+
+/**
+ * Whether a screen of this size is wide enough for two-page spreads. A book-style foldable's inner
+ * screen is near-square, so it counts as wide; the cover screen and a phone held upright stay single page.
+ */
+internal fun isWideForSpread(width: Number, height: Number): Boolean {
+    val w = width.toFloat()
+    val h = height.toFloat()
+    return w > 0f && h > 0f && w / h >= DUAL_PAGE_MIN_ASPECT_RATIO
+}
