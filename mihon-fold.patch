diff --git a/app/src/main/java/eu/kanade/tachiyomi/ui/reader/viewer/webgpu/FoldSpread.kt b/app/src/main/java/eu/kanade/tachiyomi/ui/reader/viewer/webgpu/FoldSpread.kt
